# ── MARK LVI — what never belongs in the repository ──────────────────────────
# Everything listed here is created by the app on first run.

# ── Secrets & API Keys (Gemini, ElevenLabs, Firebase, OAuth, Tokens) ──────────
config/api_keys.json
config/phone_devices.json
config/assistants.json
config/*firebase*.json
config/certs/
generated_images/
config/ui_skills.json
config/ui_skills/
config/whatsapp_web/
**/token*.json
**/client_secret*.json
*credentials*.json
.env
.env.*
*.key
*.pem

# ── Personal data the assistant accumulates about you ─────────────────────────
memory/long_term.json
memory/*.db
config/voice_fingerprint.json
config/browser_profile/
config/jarvis_local.db*

# ── Scratch & temporary tests ────────────────────────────────────────────────
scratch/
test_*.png
test_*.webp
*.bak
*.backup

# ── Python build noise ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Editors and operating systems ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Runtime output ────────────────────────────────────────────────────────────
*.log
logs/
downloads/
screenshots/
